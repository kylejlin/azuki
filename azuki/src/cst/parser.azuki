start File

rust"#[derive(Debug)]"
struct File {
    items: Items
}

manual Items 'a {
    @vec_empty
    @vec_push(Self FileItem)
}

rust"#[derive(Debug)]"
enum FileItem {
    Start($StartKw $UpperName)
    Struct(Struct)
    Enum(Enum)
    ManualNonTerminal(ManualNonTerminal)
    GeneratedTerminal(GeneratedTerminal)
    ManualTerminal(ManualTerminal)
    Bridge($BridgeKw Path)
}

rust"#[derive(Debug)]"
struct Struct {
    prefix: OptRustStringLiteral
    struct_kw: $StructKw
    name: $UpperName
    fieldset: Fieldset
}

rust"#[derive(Debug)]"
struct Enum {
    prefix: OptRustStringLiteral
    enum_kw: $EnumKw
    name: $UpperName
    lcurly: $LCurly
    variants: EnumVariants
    rcurly: $RCurly
}

rust"#[derive(Debug)]"
struct ManualNonTerminal {
    manual_kw: $ManualKw
    name: $UpperName
    override_: OptEqualAtUpperName
    lifetimes: Lifetimes
    lcurly: $LCurly
    variants: ManualNonTerminalVariants
    rcurly: $RCurly
}

rust"#[derive(Debug)]"
struct GeneratedTerminal {
    prefix: OptRustStringLiteral
    terminal_kw: $TerminalKw
    name: $UpperName
    global_lifetimes: Lifetimes
    lcurly: $LCurly
    variants: TerminalEnumVariants
    rcurly: $RCurly
}

rust"#[derive(Debug)]"
struct ManualTerminal {
    manual_kw: $ManualKw
    terminal_kw: $TerminalKw
    name: $UpperName
    override_: OptEqualAtUpperName
    global_lifetimes: Lifetimes
    lcurly: $LCurly
    variants: TerminalEnumVariants
    rcurly: $RCurly
}

manual OptRustStringLiteral 'a {
    @option_none
    @option_some($RustStringLiteral)
}

rust"#[derive(Debug)]"
enum Fieldset {
    Empty
    Named(NamedFieldset)
    Tuple(TupleFieldset)
}

rust"#[derive(Debug)]"
struct NamedFieldset {
    lcurly: $LCurly
    fields: NamedFields
    rcurly: $RCurly
}

manual NamedFields 'a {
    @vec_one(NamedField)
    @vec_push(Self NamedField)
}

rust"#[derive(Debug)]"
struct NamedField {
    name: UnderscoreOrLowerName
    colon: $Colon
    symbol: GrammarSymbolOrSelf
}

rust"#[derive(Debug)]"
struct TupleFieldset {
    lparen: $LParen
    fields: TupleFields
    rparen: $RParen
}

manual TupleFields 'a {
    @vec_one(TupleField)
    @vec_push(Self TupleField)
}

rust"#[derive(Debug)]"
enum TupleField {
    Used(GrammarSymbolOrSelf)
    Skipped($Underscore $Colon GrammarSymbolOrSelf)
}

manual EnumVariants 'a {
    @vec_one(EnumVariant)
    @vec_push(Self EnumVariant)
}

rust"#[derive(Debug)]"
struct EnumVariant {
    name: $UpperName
    fieldset: Fieldset
}

manual ManualNonTerminalVariants 'a {
    @vec_one(ManualNonTerminalVariant)
    @vec_push(Self ManualNonTerminalVariant)
}

rust"#[derive(Debug)]"
struct ManualNonTerminalVariant {
    function: $AtLowerName
    inputs: OptTupleFieldset
}

manual OptTupleFieldset 'a {
    @option_none
    @option_some(TupleFieldset)
}

manual TerminalEnumVariants 'a {
    @vec_one(TerminalEnumVariant)
    @vec_push(Self TerminalEnumVariant)
}

rust"#[derive(Debug)]"
struct TerminalEnumVariant {
    name: $DollarUpperName
    override_: OptEqualAtUpperName
    lifetimes: Lifetimes
}

manual OptEqualAtUpperName 'a {
    @option_none
    @option_some(EqualAtUpperName)
}

rust"#[derive(Debug)]"
struct EqualAtUpperName {
    equal: $Equal
    name: $AtUpperName
}

rust"#[derive(Debug)]"
struct Path {
    crate_: $CrateKw
    segments: PathSegments
}

manual PathSegments 'a {
    @vec_empty
    @vec_push(Self PathSegment)
}

rust"#[derive(Debug)]"
struct PathSegment {
    double_colon: $DoubleColon
    name: Name
}

manual Lifetimes 'a {
    @vec_empty
    @vec_push(Self $SingleQuoteLowerName)
}

rust"#[derive(Debug)]"
enum Name {
    Upper($UpperName)
    Lower($LowerName)
}

rust"#[derive(Debug)]"
enum UnderscoreOrLowerName {
    Underscore($Underscore)
    Lower($LowerName)
}

rust"#[derive(Debug)]"
enum GrammarSymbolOrSelf {
    Upper($UpperName)
    DollarUpper($DollarUpperName)
    Self_($UpperSelfKw)
}

manual terminal Token 'a {
    $StartKw 'a
    $StructKw 'a
    $EnumKw 'a
    $ManualKw 'a
    $TerminalKw 'a
    $BridgeKw 'a
    $CrateKw 'a
    $UpperSelfKw 'a

    $Underscore 'a
    $LParen 'a
    $RParen 'a
    $LSquare 'a
    $RSquare 'a
    $LCurly 'a
    $RCurly 'a
    $Comma 'a
    $DoubleColon 'a
    $Colon 'a
    $Equal 'a
    $Octothorpe 'a

    $UpperName 'a
    $LowerName 'a
    $DollarUpperName 'a
    $AtUpperName 'a
    $AtLowerName 'a
    $SingleQuoteLowerName 'a

    $RustStringLiteral 'a
}

bridge crate::cst::azuki_bridge
