{
  "name": "azuki-syntax",
  "displayName": "Azuki",
  "description": "Highlighting, navigation, rename, hover, and diagnostics for Azuki grammars.",
  "version": "0.0.2",
  "publisher": "kylejlin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kylejlin/azuki.git",
    "directory": "azuki-syntax"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./src/extension.js",
  "extensionKind": ["workspace"],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "restrictedConfigurations": ["azuki.analysisPath"]
    }
  },
  "scripts": {
    "build": "node scripts/build.js",
    "vscode:prepublish": "npm run build",
    "package": "node scripts/package.js"
  },
  "contributes": {
    "configuration": {
      "title": "Azuki",
      "properties": {
        "azuki.analysisPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Absolute path to an azuki_ide executable. Empty uses the executable bundled with this extension."
        }
      }
    },
    "configurationDefaults": {
      "[azuki]": { "editor.semanticHighlighting.enabled": true }
    },
    "languages": [
      {
        "id": "azuki",
        "aliases": [
          "Azuki",
          "azuki"
        ],
        "extensions": [
          ".azuki"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "azuki",
        "scopeName": "source.azuki",
        "path": "./syntaxes/azuki.tmLanguage.json"
      }
    ]
  },
  "dependencies": {
    "vscode-oniguruma": "^1.7.0",
    "vscode-textmate": "^9.3.2"
  }
}
